---
/**
 * Comentários via Giscus (GitHub Discussions). Configure em src/site.config.ts (GISCUS).
 * Uma discussão por review, com o slug como título: as versões em inglês e português
 * dividem os mesmos comentários.
 */
import { GISCUS } from '../site.config';
import { dicionario, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  slug: string;
}
const { idioma, slug } = Astro.props;
const t = dicionario(idioma);
const ativo = Boolean(GISCUS.repoId && GISCUS.categoryId);
---

<section class="comentarios" id="discussao" aria-labelledby="titulo-discussao">
  <h2 id="titulo-discussao">{t.review.discussao}</h2>
  {
    ativo ? (
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={GISCUS.category}
        data-category-id={GISCUS.categoryId}
        data-mapping="specific"
        data-term={slug}
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme={GISCUS.theme}
        data-lang={idioma === 'pt' ? 'pt' : 'en'}
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    ) : (
      <p class="vazio">{t.review.discussaoEmBreve}</p>
    )
  }
</section>

<style>
  .comentarios {
    margin-top: 64px;
    padding-top: 14px;
    border-top: 1px solid var(--ouro);
    scroll-margin-top: calc(var(--cabecalho-h) + 24px);
  }
  h2 {
    margin: 0 0 20px;
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ouro);
  }
  .vazio {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--texto-3);
  }
</style>
