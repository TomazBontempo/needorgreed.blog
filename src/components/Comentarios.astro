---
/**
 * Comentários via Giscus. Configure em src/site.config.ts (GISCUS).
 * Sem repoId preenchido, mostra só um aviso em desenvolvimento.
 */
import { GISCUS } from '../site.config';
const ativo = Boolean(GISCUS.repoId && GISCUS.categoryId);
---

<section class="comentarios" aria-labelledby="titulo-comentarios">
  <h2 id="titulo-comentarios">Chat do grupo</h2>
  {
    ativo ? (
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={GISCUS.category}
        data-category-id={GISCUS.categoryId}
        data-mapping={GISCUS.mapping}
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme={GISCUS.theme}
        data-lang={GISCUS.lang}
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    ) : (
      import.meta.env.DEV && (
        <p class="aviso mono">Comentários desativados: preencha GISCUS em src/site.config.ts.</p>
      )
    )
  }
</section>

<style>
  .comentarios {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--borda);
  }
  h2 {
    font-size: 1.4rem;
    margin: 0 0 20px;
  }
  .aviso {
    font-size: 13px;
    color: var(--texto-3);
  }
</style>
