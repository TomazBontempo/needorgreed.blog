---
/** Título das páginas de listagem e de texto: nome grande, uma linha de descrição e um espaço para extras. */
interface Props {
  titulo: string;
  descricao?: string;
  /** Classe de raridade (r-epico...) para colorir o título. */
  classe?: string;
}
const { titulo, descricao, classe } = Astro.props;
---

<header class:list={['topo-pagina', classe]}>
  <h1>{titulo}</h1>
  {descricao && <p class="descricao">{descricao}</p>}
  <slot />
</header>

<style>
  .topo-pagina {
    padding-block: 36px 28px;
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 0.92;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--cor, var(--texto));
  }
  .descricao {
    margin: 10px 0 0;
    max-width: 62ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--texto-2);
  }
</style>
