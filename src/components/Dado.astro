  viewBox="0 0 32 32"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linejoin="round"
>
  <path d="M16 2.5 28.5 9.5v13L16 29.5 3.5 22.5v-13z" />
  <path d="M16 2.5v8.5M3.5 9.5 16 11l12.5-1.5M16 11l-7 11.5h14z M9 22.5l-5.5 0M23 22.5h5.5M16 29.5v-7" opacity=".55" />
  <text
    x="16"
    y="19.6"
    text-anchor="middle"
    font-size="6.4"
    font-family="JetBrains Mono, monospace"
    fill="currentColor"
    stroke="none"
    font-weight="700">%</text
  >
</svg>
