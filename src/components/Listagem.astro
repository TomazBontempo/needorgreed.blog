---
/** Página de listagem genérica: título, descrição e grade de tooltips. */
import Base from '../layouts/Base.astro';
import Grade from './Grade.astro';
import type { ReviewCompleta } from '../lib/reviews';

interface Props {
  titulo: string;
  rotulo?: string;
  descricao?: string;
  reviews: ReviewCompleta[];
  classe?: string;
}
const { titulo, rotulo, descricao, reviews, classe } = Astro.props;
---

<Base titulo={titulo} descricao={descricao}>
  <section class={`container topo ${classe ?? ''}`}>
    {rotulo && <p class="rotulo">{rotulo}</p>}
    <h1>{titulo}</h1>
    {descricao && <p class="descricao">{descricao}</p>}
    <slot />
  </section>
  <section class="container">
    <Grade reviews={reviews} />
  </section>
</Base>

<style>
  .topo {
    padding-block: 56px 32px;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 6px 0 10px;
    color: var(--cor, var(--texto));
  }
  .descricao {
    color: var(--texto-2);
    max-width: 60ch;
    margin: 0 0 20px;
  }
</style>
