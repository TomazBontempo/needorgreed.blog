---
/** As raridades em linha, cada uma com sua cor e quantas reviews tem. Leva às páginas de raridade. */
import { dicionario, url, type Idioma } from '../i18n';
import { TODAS_RARIDADES, type RaridadeId } from '../lib/raridade';
import { getReviews } from '../lib/reviews';

interface Props {
  idioma: Idioma;
  atual?: RaridadeId;
}
const { idioma, atual } = Astro.props;
const t = dicionario(idioma);
const reviews = await getReviews();
const contagem = (id: RaridadeId) => reviews.filter((r) => r.raridade.id === id).length;
---

<nav class="legenda" aria-label={t.paginas.raridades}>
  <ul>
    {
      TODAS_RARIDADES.map((r) => (
        <li class={`r-${r.id}`}>
          <a href={url(idioma, 'raridade', r.id)} aria-current={atual === r.id ? 'page' : undefined}>
            {t.raridades[r.id].nome}
          </a>
          <span class="n">{contagem(r.id)}</span>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .legenda ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  a {
    color: var(--cor);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .n {
    margin-left: 6px;
    color: var(--texto-3);
  }
</style>
