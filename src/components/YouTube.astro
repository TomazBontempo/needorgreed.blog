---
/**
 * Uso dentro de uma review .mdx:
 *   <YouTube id="dQw4w9WgXcQ" />
 * No painel, é o bloco "Vídeo do YouTube".
 * Usa youtube-nocookie para não rastrear o leitor antes do play.
 */
interface Props {
  id: string;
  titulo?: string;
}
const { id, titulo = 'YouTube' } = Astro.props;
---

<div class="video">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={titulo}
    loading="lazy"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
</div>

<style>
  .video {
    aspect-ratio: 16 / 9;
    margin: 1.8em 0;
    border: 1px solid var(--borda);
    outline: 1px solid var(--borda);
    outline-offset: 3px;
    background: #000;
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
