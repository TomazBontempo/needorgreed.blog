---
/**
 * Home, ordem fixa: hero curto, a review mais recente inteira (com o loot log ao lado,
 * ou depois dela no celular) e "Mais loot".
 *
 * "Mais loot" é para descobrir, não cronológico (o log já é a ordem do tempo): o build manda um
 * conjunto de fichas e um script inline sorteia quais aparecem, antes da primeira pintura.
 * Sem JavaScript, ficam as primeiras na ordem do build.
 *
 * No desktop, a primeira tela (hero + destaque) tem a altura da tela menos o header e menos uma
 * faixa (--espiar) onde aparecem o título e o topo de "Mais loot". O hero tem até 65px de respiro
 * em cima e embaixo: esse respiro empurra a página em vez de espremer o destaque, até o limite em
 * que ainda dá para ver o título de "Mais loot" e uma ponta das fichas (--espiar-minimo).
 * Em tela baixa, o respiro diminui para respeitar esse limite; em tela muito baixa, o destaque também.
 */
import Base from '../layouts/Base.astro';
import DestaqueHome from '../components/DestaqueHome.astro';
import LootLog from '../components/LootLog.astro';
import Item from '../components/Item.astro';
import { dicionario, idiomaDe, url } from '../i18n';
import { getReviews, versaoEm } from '../lib/reviews';
import { getLootLog } from '../lib/lootlog';
import { SITE } from '../site.config';

/** Quantos eventos o log da home mostra (as reviews que aparecem nele vão para o fim da fila do sorteio). */
const EVENTOS_NO_LOG = 14;
/** Fichas no HTML para o sorteio. As escondidas não baixam a capa (loading lazy). */
const TAMANHO_DO_SORTEIO = 24;
/** Fichas visíveis sem JavaScript. */
const VISIVEIS_SEM_JS = 6;

const idioma = idiomaDe(Astro);
const t = dicionario(idioma);
const reviews = await getReviews();
const [destaque, ...resto] = reviews;
const versaoDestaque = destaque && (await versaoEm(destaque, idioma));
const { eventos } = await getLootLog();

// Dados estruturados: o nome do site nos resultados do Google.
const site = Astro.site ?? new URL(SITE.url);
const dados = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.nome,
  url: new URL(url(idioma), site).href,
  inLanguage: t.hreflang,
  description: t.site.descricao,
};

// Sorteio: nunca a review em destaque (a não ser que ela seja a única, para a seção não sumir);
// primeiro as que não aparecem no log, depois as que aparecem.
const sorteaveis = resto.length ? resto : reviews;
const noLog = new Set(eventos.slice(0, EVENTOS_NO_LOG).flatMap((e) => (e.tipo === 'autor' ? [] : [e.review.slug])));
const fila = [...sorteaveis.filter((r) => !noLog.has(r.slug)), ...sorteaveis.filter((r) => noLog.has(r.slug))].slice(0, TAMANHO_DO_SORTEIO);
const mais = await Promise.all(fila.map(async (r) => ({ review: r, versao: await versaoEm(r, idioma), noLog: noLog.has(r.slug) })));

/**
 * Sorteio das fichas. Inline e logo depois da lista: roda antes da primeira pintura,
 * então nada troca de lugar na frente do leitor.
 *  - Vagas: duas fileiras cheias, no mínimo 6 (as colunas crescem com a tela).
 *  - Só sorteia se houver mais fichas que vagas; senão mostra todas, na ordem do build.
 *  - Prefere as que não estão no log; as do log só completam.
 *  - O botão d100 sorteia de novo (com animação curta, sem ela em movimento reduzido).
 */
const SORTEIO = `(() => {
  const lista = document.getElementById('fichario');
  const botao = document.getElementById('rerolar');
  const aviso = document.getElementById('rerolado');
  if (!lista || !botao) return;
  const fichas = [...lista.children];
  const fora = fichas.filter((li) => !li.hasAttribute('data-no-log'));
  const doLog = fichas.filter((li) => li.hasAttribute('data-no-log'));
  const embaralhar = (a) => {
    a = a.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  };
  const vagas = () => {
    const colunas = getComputedStyle(lista).gridTemplateColumns.split(' ').filter(Boolean).length || 1;
    return Math.max(6, colunas * 2);
  };
  let ordem = fichas;
  const sortear = (n) => {
    if (fichas.length <= n) return fichas;
    const escolhidas = fora.length >= n ? embaralhar(fora).slice(0, n) : fora.concat(embaralhar(doLog).slice(0, n - fora.length));
    return embaralhar(escolhidas).concat(fichas.filter((li) => !escolhidas.includes(li)));
  };
  const mostrar = () => {
    const n = vagas();
    botao.hidden = fichas.length <= n;
    if (fichas.length <= n) ordem = fichas;
    ordem.forEach((li, i) => {
      li.hidden = i >= n;
      lista.append(li);
    });
  };
  ordem = sortear(vagas());
  mostrar();

  let colunasAntes = vagas();
  addEventListener('resize', () => {
    const n = vagas();
    if (n !== colunasAntes) {
      colunasAntes = n;
      if (ordem === fichas) ordem = sortear(n);
      mostrar();
    }
  });

  const calmo = matchMedia('(prefers-reduced-motion: reduce)');
  botao.addEventListener('click', () => {
    const n = vagas();
    const antes = ordem.slice(0, n);
    let nova = sortear(n);
    for (let t = 0; t < 5 && nova.slice(0, n).every((li, i) => li === antes[i]); t++) nova = sortear(n);
    const trocar = () => {
      ordem = nova;
      mostrar();
      aviso.textContent = '';
      aviso.textContent = aviso.dataset.texto;
    };
    if (calmo.matches) return trocar();
    botao.classList.add('rolando');
    lista.classList.add('saindo');
    setTimeout(() => {
      trocar();
      lista.classList.remove('saindo');
      lista.classList.add('entrando');
      requestAnimationFrame(() => requestAnimationFrame(() => lista.classList.remove('entrando')));
    }, 160);
    setTimeout(() => botao.classList.remove('rolando'), 450);
  });
})();`;
---

<Base largura="1232px" dados={dados}>
  <div class="primeira-tela">
    <section class="hero">
      <div class="container">
        <h1>{t.hero.titulo}</h1>
        <p>
          <span>{t.hero.descricao1}</span>
          <span>{t.hero.descricao2}</span>
        </p>
        <p class="saiba"><a href={url(idioma, 'sobre')}>{t.hero.saibaMais}</a></p>
      </div>
    </section>

    <div class="container mesa">
      {destaque && versaoDestaque && <DestaqueHome idioma={idioma} review={destaque} versao={versaoDestaque} />}
      <LootLog idioma={idioma} eventos={eventos} limite={EVENTOS_NO_LOG} class="lateral" />
    </div>
  </div>


  {
    mais.length > 0 && (
      <section class="container mais" aria-labelledby="titulo-mais">
        <header class="topo-mais">
          <h2 id="titulo-mais">{t.paginas.maisLoot}</h2>
          <button type="button" class="rerolar" id="rerolar" aria-label={t.paginas.rerolar} title={t.paginas.rerolar} hidden>
            <svg viewBox="0 0 26 26" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M13 1.5 23.5 7.5v11L13 24.5 2.5 18.5v-11z" />
              <path d="M13 1.5v8M2.5 7.5 13 9.5l10.5-2M13 9.5 7 18.5h12zM2.5 18.5 7 18.5M23.5 18.5H19M13 24.5 7 18.5M13 24.5l6-6" />
            </svg>
          </button>
          <a href={url(idioma, 'arquivo')}>{t.paginas.verTodos}</a>
        </header>
        <p class="sr-only" aria-live="polite" id="rerolado" data-texto={t.paginas.rerolado} />
        <ul class="fichario" id="fichario">
          {mais.map(({ review, versao, noLog }, i) => (
            <li data-no-log={noLog ? '' : undefined} hidden={i >= VISIVEIS_SEM_JS}>
              <Item review={review} data={versao.data} idioma={idioma} variante="bolso" />
            </li>
          ))}
        </ul>
        <script is:inline set:html={SORTEIO} />
      </section>
    )
  }
</Base>


<style>
  .primeira-tela {
    /* Altura da tela, menos o header, menos a faixa onde "Mais loot" aparece. */
    --espiar: clamp(200px, 26dvh, 300px);
    /* O mínimo que precisa aparecer de "Mais loot": título (116px até a ficha) e 32px de ficha. */
    --espiar-minimo: 148px;
    /* Altura com o respiro mínimo do hero (36px e 38px); o destaque fica sempre com este tamanho. */
    --base: max(500px, calc(100dvh - var(--cabecalho-h) - var(--espiar)));
    /* Quanto sobra (positivo) ou falta (negativo) para o limite de "Mais loot". */
    --folga: calc(100dvh - var(--cabecalho-h) - var(--base) - var(--espiar-minimo));
    /* O respiro do hero cresce até 56px a mais ou encolhe até 56px a menos. */
    --extra: clamp(-56px, var(--folga), 56px);
    /* Se nem o respiro mínimo resolve (tela muito baixa), o destaque encolhe, até 380px de primeira tela. */
    height: calc(var(--base) + min(56px, var(--folga)));
    min-height: 380px;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  /* Largura total, mesmo fundo da página; o conteúdo usa a largura do header. */
  .hero .container {
    max-width: var(--largura-cabecalho);
    /* 36px e 38px de base, até 65px nos dois quando a tela deixa (ver --extra). */
    padding-top: calc(36px + var(--extra) * 29 / 56);
    padding-bottom: calc(38px + var(--extra) * 27 / 56);
  }
  .mesa {
    margin-top: 20px;
  }
  .hero h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.125rem, 1.3rem + 1.7vw, 2.875rem);
    line-height: 1;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }
  .hero p span {
    display: block;
  }
  /* Uma linha em branco entre a explicação e o link. */
  .hero .saiba {
    margin-top: 1.45em;
  }
  .hero p {
    margin: 10px 0 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--texto-2);
  }

  .mesa {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 32px;
  }
  .mesa :global(.lateral) {
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--borda-forte) transparent;
  }

  .mais {
    margin-top: 28px;
  }
  .topo-mais {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 10px;
    border-top: 1px solid var(--ouro);
    margin-bottom: 16px;
  }
  .topo-mais a {
    margin-left: auto;
  }
  .topo-mais h2 {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    text-transform: uppercase;
  }
  .topo-mais a {
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .rerolar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: none;
    border: 1px solid var(--borda-forte);
    color: var(--ouro);
    cursor: pointer;
    transition: border-color 150ms var(--ease);
  }
  .rerolar[hidden] {
    display: none;
  }
  .rerolar:hover {
    border-color: var(--ouro);
  }
  .rerolar svg {
    transition: transform 420ms var(--ease);
  }
  .rerolar:global(.rolando) svg {
    transform: rotate(360deg);
  }

  .fichario > li {
    transition:
      opacity 150ms var(--ease),
      transform 150ms var(--ease);
  }
  .fichario:global(.saindo) > li,
  .fichario:global(.entrando) > li {
    opacity: 0;
    transform: scale(0.97);
  }
  .fichario {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin: 0;
    padding: 24px;
    list-style: none;
    background: var(--painel-fundo);
    border: 1px solid var(--borda);
  }

  @media (max-width: 1100px) {
    .mesa {
      grid-template-columns: minmax(0, 1fr) 240px;
      gap: 24px;
    }
  }
  /* Celular e tablet em pé: sem altura fixa, sem rolagem interna. */
  @media (max-width: 900px) {
    .primeira-tela {
      height: auto;
      min-height: 0;
      display: block;
    }
    .mesa {
      display: block;
    }
    .mesa :global(.lateral) {
      overflow: visible;
      margin-top: 56px;
    }
    .mais {
      margin-top: 64px;
    }
    .fichario {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 20px;
      gap: 20px;
    }
  }
  @media (max-width: 640px) {
    .fichario {
      grid-template-columns: minmax(0, 1fr);
      padding: 12px;
      gap: 12px;
    }
  }
  /* ---------- Celular e tablet em pé (abaixo de 900px): tudo empilhado ----------
     Hero curto, a última crítica compacta (sem o texto), os 5 últimos eventos do log e "Mais loot"
     em lista. O desktop não muda. */
  @media (max-width: 900px) {
    .hero .container {
      padding-block: 24px 8px;
    }
    .hero h1 {
      font-size: 1.75rem;
    }
    .hero p {
      margin: 8px 0 0;
      font-size: 0.875rem;
      line-height: 1.5;
    }
    .hero .saiba {
      margin-top: 4px;
    }
    .mesa {
      margin-top: 24px;
    }
    .mesa :global(.lateral li:nth-child(n + 6)) {
      display: none;
    }
    .mesa :global(.lateral) {
      margin-top: 40px;
    }
    .mais {
      margin-top: 48px;
    }
    .topo-mais h2 {
      font-size: 1.6rem;
    }
  }
  /* Celular: nenhum texto abaixo de 13px e alvos de toque de 44px. */
  @media (max-width: 720px) {
    .rerolar {
      width: 44px;
      height: 44px;
    }
    .topo-mais a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    /* Uma moldura só: sem o painel em volta das fichas. */
    .fichario {
      padding: 0;
      background: none;
      border: 0;
    }
    .hero p a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
