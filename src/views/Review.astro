---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ReviewCompleta from '../components/ReviewCompleta.astro';
import { dicionario, idiomaDe, url } from '../i18n';
import { SITE } from '../site.config';
import { versaoEm, type ReviewCompleta as Review } from '../lib/reviews';

interface Props {
  review: Review;
}

const { review } = Astro.props;
const idioma = idiomaDe(Astro);
const t = dicionario(idioma);
const versao = await versaoEm(review, idioma);
const { data } = versao;
const og = (await getImage({ src: data.capa, width: 1200, format: 'jpg' })).src;
const descricao = data.motivoRoll ?? data.frase ?? `${t.rolls[data.roll].nome}: ${data.titulo}`;

// Dados estruturados: dizem ao Google e às IAs qual obra foi avaliada, a nota, quem escreveu e quando.
const site = Astro.site ?? new URL(SITE.url);
const abs = (caminho: string) => new URL(caminho, site).href;
const TIPO_DA_OBRA = { jogo: 'VideoGame', filme: 'Movie', serie: 'TVSeries', anime: 'TVSeries' } as const;
const dados = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: data.titulo,
  url: abs(url(idioma, 'reviews', review.slug)),
  inLanguage: t.hreflang,
  datePublished: data.data.toISOString().slice(0, 10),
  description: descricao,
  image: abs(og),
  itemReviewed: {
    '@type': TIPO_DA_OBRA[data.tipo],
    name: data.titulo,
    image: abs(og),
    ...(data.tipo === 'jogo' && data.plataforma ? { gamePlatform: data.plataforma } : {}),
  },
  reviewRating: { '@type': 'Rating', ratingValue: data.nota, bestRating: 10, worstRating: 0 },
  author: { '@type': 'Person', name: review.autor.nick, url: abs(url(idioma, 'autores', review.autor.slug)) },
  publisher: { '@type': 'Organization', name: SITE.nome, url: abs(url(idioma)) },
};
---

<Base titulo={data.titulo} descricao={descricao} imagem={og} artigo dados={dados}>
  <div class="container pagina">
    <ReviewCompleta idioma={idioma} review={review} versao={versao} />
  </div>
</Base>

<style>
  .pagina {
    padding-top: 40px;
  }
</style>
