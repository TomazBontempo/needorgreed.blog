---
import { Font } from 'astro:assets';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import SugestaoIdioma from '../components/SugestaoIdioma.astro';
import { alternativas, dicionario, idiomaDe } from '../i18n';
import '../styles/global.css';
import '../styles/item.css';

interface Props {
  titulo?: string;
  descricao?: string;
  /** URL absoluta ou relativa da imagem de compartilhamento. Sem ela, vale a imagem padrão do site. */
  imagem?: string;
  /** Página de review: og:type article. */
  artigo?: boolean;
  /** Largura máxima do conteúdo nesta página (padrão: --largura do global.css). Header e conteúdo seguem a mesma. */
  largura?: string;
  /** Fora dos buscadores (404). */
  noindex?: boolean;
  /** Dados estruturados (JSON-LD) da página, para o Google e as IAs. */
  dados?: Record<string, unknown>;
}

const idioma = idiomaDe(Astro);
const t = dicionario(idioma);
const { titulo, descricao = t.site.descricao, imagem = '/og.jpg', artigo = false, largura, noindex = false, dados } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · Need or Greed` : 'Need or Greed';
const site = Astro.site ?? new URL('https://needorgreed.blog');
const { canonical, links } = alternativas(Astro.url.pathname, site);
const imagemAbs = new URL(imagem, site).href;
const rss = idioma === 'en' ? '/rss.xml' : `/${idioma}/rss.xml`;

// Contrato da direção visual (Impeccable). Fica como comentário no HTML publicado.
const contrato = `
THESIS: every review is a numbered piece of loot logged by the system; one glance at the first screen shows everything the home offers; refuses the score-circle plus card-grid review site.
OWN-WORLD: tavern-night ground, dark item panels with a rarity-coloured edge and a loose second outline, no foil, no hover tricks; condensed display caps, a reading serif, a mono for system text; gold only where you can click.
STORY: the reader sees how good a work is (rarity) and whether it is worth their time (roll) as two separate claims, reads the latest review whole, then joins the discussion.
FIRST VIEWPORT: logo left, menu and language toggle right; three-line hero; latest review in a fixed-height scrolling window (dvh) with the loot log right; the top of More loot visible below.
FORM: item binder (cards kept for listings, TCG trappings removed on user feedback), 6th of 7 on the ordered list, seed 763e2d68.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
`;
---

<!doctype html>
<html lang={t.hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <!-- A mesma cor do --fundo (global.css): meta não lê variável de CSS. -->
    <meta name="theme-color" content="#0f0d0b" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && links.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    <link rel="alternate" type="application/rss+xml" title="Need or Greed" href={rss} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:site_name" content="Need or Greed" />
    <meta property="og:type" content={artigo ? 'article' : 'website'} />
    <meta property="og:title" content={titulo ?? 'Need or Greed'} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.locale.replace('-', '_')} />
    <meta property="og:image" content={imagemAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      /* "<" escapado: um título com "</script>" não fecha a tag antes da hora. */
      dados && <script type="application/ld+json" set:html={JSON.stringify(dados).replace(/</g, '\\u003c')} />
    }

    <Font cssVariable="--fonte-display" preload />
    <Font cssVariable="--fonte-texto" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--fonte-mono" preload={[{ style: 'normal' }]} />
  </head>
  <body style={largura ? `--largura: ${largura}` : undefined}>
    <Fragment set:html={`<!--${contrato}-->`} />
    <a class="pular" href="#conteudo">{t.nav.pularParaConteudo}</a>
    <!-- Descrição dos links externos (aria-describedby): o leitor de tela ouve que abrem em nova guia. -->
    <span id="aviso-nova-guia" hidden>{t.links.novaGuia}</span>
    <Cabecalho idioma={idioma} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape idioma={idioma} />
    <SugestaoIdioma idioma={idioma} />

    <script>
      // Escolha de idioma: grava cookie (o Worker lê) e espelha no localStorage.
      const UM_ANO = 60 * 60 * 24 * 365;
      const gravar = (lang: string) => {
        document.cookie = `lang=${lang}; Path=/; Max-Age=${UM_ANO}; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
        try {
          localStorage.setItem('lang', lang);
        } catch {}
      };
      // Escolha antiga que só ficou no localStorage: devolve para o cookie.
      try {
        const salvo = localStorage.getItem('lang');
        if (salvo && !document.cookie.includes('lang=')) gravar(salvo);
      } catch {}
      document.querySelectorAll<HTMLAnchorElement>('[data-idioma]').forEach((a) =>
        a.addEventListener('click', () => gravar(a.dataset.idioma!)),
      );

      // Reviews já lidas: marca no log e nas fichas quando o leitor volta.
      try {
        const lidos = new Set<string>(JSON.parse(localStorage.getItem('lidos') ?? '[]'));
        const atual = document.body.querySelector<HTMLElement>('[data-lendo]')?.dataset.lendo;
        if (atual) {
          lidos.add(atual);
          localStorage.setItem('lidos', JSON.stringify([...lidos].slice(-300)));
        }
        document.querySelectorAll<HTMLElement>('[data-slug]').forEach((el) => {
          if (lidos.has(el.dataset.slug!) && el.dataset.slug !== atual) el.classList.add('lido');
        });
      } catch {}

      // Contador de views (servidor em src/views-api.ts). Na página da review, conta a visita no máximo
      // 1 vez a cada 30 minutos por navegador; depois busca os totais de todas as reviews que aparecem
      // na página (e no loot log, para o tooltip) numa chamada só. Se algo falhar, o número só não aparece.
      (async () => {
        const totais: Record<string, number> = {};
        const formatar = (el: HTMLElement, n: number) => {
          const d = el.dataset.viewsDecimal ?? '.';
          const curto = (v: number, s: string) => `${(Math.floor(v * 10) / 10).toFixed(1).replace(/\.0$/, '').replace('.', d)}${s}`;
          const num = n >= 1e6 ? curto(n / 1e6, 'M') : n >= 1e3 ? curto(n / 1e3, 'K') : String(n);
          return `${num} ${n === 1 ? el.dataset.viewsUm : el.dataset.viewsVarios}`;
        };
        const preencher = (raiz: ParentNode = document) =>
          raiz.querySelectorAll<HTMLElement>('[data-views]').forEach((el) => {
            const n = totais[el.dataset.views!];
            // Zero não aparece: o contador surge a partir de 1 view.
            if (!n) return;
            el.textContent = formatar(el, n);
            el.hidden = false;
          });
        (window as unknown as { nogViews?: typeof preencher }).nogViews = preencher;
        if (navigator.webdriver) return;

        const contar = document.querySelector<HTMLElement>('[data-views-contar]')?.dataset.views;
        if (contar) {
          const chave = `views:${contar}`;
          let ultima = 0;
          try {
            ultima = Number(localStorage.getItem(chave) ?? 0);
          } catch {}
          if (Date.now() - ultima > 30 * 60 * 1000) {
            try {
              const r = await fetch(`/api/views/${contar}`, { method: 'POST' });
              if (r.ok) {
                totais[contar] = ((await r.json()) as { total: number }).total;
                try {
                  localStorage.setItem(chave, String(Date.now()));
                } catch {}
              }
            } catch {}
          }
        }

        const slugs = new Set<string>();
        document.querySelectorAll<HTMLElement>('[data-views]').forEach((el) => slugs.add(el.dataset.views!));
        document.querySelectorAll<HTMLElement>('[data-ficha]').forEach((el) => {
          const m = el.dataset.ficha!.match(/^\/fichas\/[a-z]{2}-(.+)\/$/);
          if (m) slugs.add(m[1]);
        });
        if (!slugs.size) return;
        try {
          const r = await fetch(`/api/views?slugs=${[...slugs].sort().join(',')}`);
          if (r.ok) {
            const { totais: lidos } = (await r.json()) as { totais: Record<string, number> };
            for (const s of slugs) totais[s] = Math.max(totais[s] ?? 0, lidos[s] ?? 0);
          }
        } catch {}
        preencher();
      })();
    </script>
  </body>
</html>
