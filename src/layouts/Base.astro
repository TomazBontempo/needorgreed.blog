---
import '../styles/global.css';
import Dado from '../components/Dado.astro';
import { SITE } from '../site.config';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
}

const { titulo, descricao = SITE.descricao, imagem } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITE.nome}` : SITE.nome;
const canonical = new URL(Astro.url.pathname, Astro.site);
const atual = Astro.url.pathname;

const nav = [
  { href: '/jogos/', nome: 'Jogos' },
  { href: '/telas/', nome: 'Telas' },
  { href: '/arquivo/', nome: 'Arquivo' },
  { href: '/sobre/', nome: 'Sobre' },
];
---

<!doctype html>
<html lang={SITE.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.nome} href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    {imagem && <meta property="og:image" content={new URL(imagem, Astro.site)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topo">
      <div class="container topo-inner">
        <a href="/" class="marca">
          <span class="marca-dado"><Dado tamanho={30} /></span>
          <span class="marca-nome">Need <em>or</em> Greed</span>
        </a>
        <nav aria-label="Principal">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={atual.startsWith(item.href) ? 'page' : undefined}>
                {item.nome}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="rodape">
      <div class="container rodape-inner">
        <p class="mono">Master Looter: Snufupugos</p>
        <p>
          <a href="/rss.xml">RSS</a> · <a href="/sobre/">Como funcionam as notas</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .topo {
    border-bottom: 1px solid var(--borda);
    background: #0f0d0bcc;
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .topo-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--texto);
  }
  .marca-dado {
    color: var(--ouro);
    display: flex;
  }
  .marca-nome {
    font-family: var(--fonte-titulo);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .marca-nome em {
    font-style: italic;
    font-weight: 500;
    color: var(--texto-2);
  }
  nav {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--texto-2);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: var(--raio);
    font-size: 15px;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--texto);
    background: var(--bg-2);
  }
  main {
    min-height: 70vh;
  }
  .rodape {
    margin-top: 96px;
    border-top: 1px solid var(--borda);
    color: var(--texto-3);
    font-size: 14px;
  }
  .rodape-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-block: 24px;
  }
  .rodape a {
    color: var(--texto-2);
  }
</style>
