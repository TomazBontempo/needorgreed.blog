---
import Listagem from '../../components/Listagem.astro';
import LegendaRaridade from '../../components/LegendaRaridade.astro';
import { getReviews } from '../../lib/reviews';
import { TODAS_RARIDADES, type Raridade } from '../../lib/raridade';

export function getStaticPaths() {
  return TODAS_RARIDADES.map((raridade) => ({ params: { tier: raridade.id }, props: { raridade } }));
}

interface Props {
  raridade: Raridade;
}

const { raridade } = Astro.props;
const reviews = (await getReviews()).filter((r) => r.raridade.id === raridade.id);
const descricao =
  raridade.id === 'heranca'
    ? 'As obras da vida. Nenhuma imparcialidade aqui.'
    : `Nota ${raridade.faixa}.`;
---

<Listagem titulo={raridade.nome} rotulo="Raridade" descricao={descricao} reviews={reviews} classe={`r-${raridade.id}`}>
  <LegendaRaridade />
</Listagem>
