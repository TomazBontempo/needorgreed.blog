---
import Base from '../layouts/Base.astro';
import Grade from '../components/Grade.astro';
import RollLine from '../components/RollLine.astro';
import LegendaRaridade from '../components/LegendaRaridade.astro';
import { getReviews } from '../lib/reviews';

const reviews = await getReviews();
const ultimosRolls = reviews.slice(0, 6);
---

<Base>
  <section class="hero container">
    <p class="rotulo">Loot distribuído por Snufupugos</p>
    <h1>Cada obra é um loot.<br /><span>Need, Greed ou Pass.</span></h1>
    <p class="sub">
      Críticas de jogos, séries, filmes e animes. A raridade diz o quão bom é, o roll diz se vale pegar.
    </p>

    {
      ultimosRolls.length > 0 && (
        <div class="chat" aria-label="Últimos rolls">
          <p class="chat-titulo mono">[Loot]</p>
          {ultimosRolls.map((r) => (
            <RollLine
              nick={r.autor.nick}
              autorSlug={r.autor.slug}
              roll={r.entry.data.roll}
              valor={r.valorRoll}
              titulo={r.entry.data.titulo}
              raridade={r.raridade}
              href={r.url}
            />
          ))}
        </div>
      )
    }
  </section>

  <section class="container bloco">
    <div class="cabecalho">
      <h2>Últimas reviews</h2>
      <LegendaRaridade />
    </div>
    <Grade reviews={reviews.slice(0, 12)} />
  </section>
</Base>

<style>
  .hero {
    padding-block: 72px 40px;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin: 10px 0 16px;
  }
  h1 span {
    color: var(--ouro);
    font-style: italic;
    font-weight: 500;
  }
  .sub {
    color: var(--texto-2);
    max-width: 56ch;
    margin: 0 0 32px;
  }
  .chat {
    max-width: 640px;
    padding: 14px 16px;
    background: #0a0907cc;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    display: grid;
    gap: 4px;
  }
  .chat-titulo {
    margin: 0 0 4px;
    font-size: 12px;
    color: var(--ouro);
  }
  .bloco {
    padding-top: 24px;
  }
  .cabecalho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .cabecalho h2 {
    margin: 0;
    font-size: 1.6rem;
  }
</style>
