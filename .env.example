# Build: descobrir o autor de cada review pela API do GitHub
GITHUB_REPO=TomazBontempo/needorgreed.blog
# Token fine-grained, só leitura de "Contents" e "Metadata" no repositório.
# Opcional para repo público, obrigatório se o repo for privado.
GITHUB_TOKEN=

# Painel Keystatic em produção (gerados no setup do GitHub App, veja o README)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Tradução automática (npm run translate). Cloudflare Workers AI, plano Free, sem cartão.
# Token com permissão só de Workers AI (Read + Edit). Na Action, ficam em secrets do repositório.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# TRANSLATE_MODEL=@cf/google/gemma-4-26b-a4b-it
