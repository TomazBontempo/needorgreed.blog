{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "needorgreed",
  "compatibility_date": "2026-10-19",
  // Worker próprio: decide o idioma e depois chama o handler do Astro.
  "main": "./src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    // Sem isto, as páginas estáticas são servidas direto e o Worker nunca vê a visita,
    // então o redirecionamento por idioma não acontece. Só as rotas HTML passam pelo Worker.
    "run_worker_first": ["/*", "!/_astro/*", "!/*.xml", "!/*.svg", "!/*.png", "!/*.jpg", "!/*.webp", "!/*.ico", "!/*.txt", "!/*.mp4", "!/*.webm", "!/videos/*", "!/fichas/*"]
  },
  "observability": { "enabled": true },
  // Contador de views das reviews (src/views-api.ts). Migrações em ./migrations: npx wrangler d1 migrations apply VIEWS --remote
  "d1_databases": [
    { "binding": "VIEWS", "database_name": "needorgreed-views", "database_id": "b582303a-df19-4147-9468-9e631f83a63f" }
  ]
}
